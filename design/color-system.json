  "rules": {
    "hierarchy": "层级只由中性表面明度和悬浮阴影表达；不用描边、边框或饱和色块区分层级与重点。",
    "normal": "平面基础层；无卡片、描边或阴影；图标保持中性单色。",
    "hover": "在当前表面上轻抬一层：表面回到浮动层并用柔和阴影；不改变文字/图标颜色，不加描边。",
    "pressed": "按压时阴影收紧、位移 1px；不新增语义填充色。",
    "selected": "文件/导航选中态优先用抬起的表面+阴影；不使用蓝色填充或描边；文字保持常规字重。",
    "focus": "焦点用柔和光晕与轻微抬升表达；accent 只作为可访问性指示，不做粗描边。",
    "inactive-selected": "失去窗口焦点时保留抬升几何，降低阴影强度；不改变文字颜色。",
    "disabled": "仅降低文字/图标不透明度，不引入新的轮廓或色块。",
    "floating": "菜单、提示、任务面板和对话框使用浮动表面与分层阴影；浮层之间靠高度差区分，不靠描边。",
    "rhythm": "状态切换保持几何不变；只有 z 位移、阴影强度与表面明度参与强调。"
  }
